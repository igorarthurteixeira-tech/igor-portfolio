# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# E-mail do único usuário autorizado a entrar em /admin
ADMIN_EMAIL=

# Chave do agendador que dispara /api/publicar/disparar (Authorization: Bearer ...)
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
